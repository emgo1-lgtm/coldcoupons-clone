    <script>
        function getCouponFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('coupon');
        }
        // Define global revealFullCode function
        window.revealFullCode = function() {
            const modalStore = Alpine.store('couponModal');
            if (modalStore) {
                // Call a new method that handles all state updates
                modalStore.completeUnlock();
            }
        };
        // Utility function for safe URL decoding
        function safeDecodeUrl(url) {
            if (!url) return '';
            try {
                return decodeURIComponent(url);
            } catch (e) {
                console.error('Error decoding URL:', e);
                return url;
            }
        }
        document.addEventListener('alpine:init', () => {

            const setModalHeight = () => {
                if (window.innerWidth < 768) {
                    const vh = window.innerHeight * 0.01;
                    document.documentElement.style.setProperty('--vh', `${vh}px`);
                }
            };

            // Set initial height
            setModalHeight();

            // Update on resize and orientation change
            window.addEventListener('resize', setModalHeight);
            window.addEventListener('orientationchange', () => {
                setTimeout(setModalHeight, 100);
            });

            Alpine.store('couponModal', {
                isOpen: false,
                coupon: null,
                baseUrl: 'https://coldcoupons.com',
                usesToday: 0,
                currentStep: 1,
                processingProgress: 0,
                currentMessage: '',
                showCheckmark: false,
                codeRevealed: false,
                isLoading: false,
                isRevealed: false,
                settings: {
                    totalDuration: 10000,
                    processSteps: [
                        { 
                            message: "Checking amount of codes left...", 
                            showAtPercent: 1                        },
                        { 
                            message: "Checking chosen code validity...", 
                            showAtPercent: 30                        },
                        { 
                            message: "This code is valid!", 
                            showAtPercent: 85                        }
                    ],
                    locker: {
                        enable_locker: true,
                        locrul_occ: "OGLock();",
                        locrul_ocsc: "        <script>\nfunction OGLock() {\n  window.open(\"https:\/\/unlockedrobot.com\/cl\/i\/2lj456\");\n}\n<\/script>",
                        unlock_method: "function",
                        unlock_delay: 5                    },
                    appearance: {
                        show_ratings: true,
                        show_random_uses: true,
                        show_available_coupons: true                    }
                },
                translations: {
                    expiresIn: "Expires in"                },
                
                init() {
                    // Listen for count updates
                    window.addEventListener('couponCountUpdated', (event) => {
                        if (this.coupon && this.coupon.id === event.detail.couponId) {
                            // Force Alpine to re-render the count
                            Alpine.nextTick(() => {
                                this.coupon = { ...this.coupon };
                            });
                        }
                    });

                    window.addEventListener('orientationchange', () => {
                        if (this.isOpen) {
                            setTimeout(setViewportHeight, 100);
                        }
                    });
                },

                async open(couponId) {
                    try {
                        // Show overlay immediately with loading state
                        this.isOpen = true;
                        
                        // Get scroll position before doing anything
                        const scrollPos = window.pageYOffset || document.documentElement.scrollTop;
                        
                        // Lock the body scroll at current position
                        document.body.classList.add('modal-open');
                        document.body.style.top = `-${scrollPos}px`;
                        document.body.style.width = '100%';
                        
                        // Fetch data
                        const url = `${this.baseUrl}/api/coupons/${couponId}`;
                        const response = await fetch(url);
                        if (!response.ok) throw new Error('Failed to fetch coupon data');
                        
                        // Set coupon data which will trigger the modal slide in
                        this.coupon = await response.json();
                        
                        window.dispatchEvent(new CustomEvent('coupon-changed', {
                            detail: { couponId: this.coupon.id }
                        }));
                        
                        const usesData = JSON.parse(localStorage.getItem('coupon_uses_today') || '{}');
                        this.usesToday = usesData.uses?.[couponId] || Math.floor(Math.random() * 50) + 20;
                        
                        // Store scroll position explicitly
                        this.scrollPosition = scrollPos;
                        
                        // Remove any lingering closing attribute
                        const modalOverlay = document.querySelector('.modal-overlay');
                        if (modalOverlay) {
                            modalOverlay.removeAttribute('closing');
                        }
                        
                        return false;
                    } catch (error) {
                        console.error('Error in open():', error);
                        // Handle error state
                        this.isOpen = false;
                        document.body.classList.remove('modal-open');
                        document.body.style.position = '';
                        document.body.style.width = '';
                        document.body.style.top = '';
                    }
                },

                close() {
                    const modalOverlay = document.querySelector('.modal-overlay');
                    const isMobile = window.innerWidth <= 768;
                    
                    if (isMobile) {
                        // Mobile: Add closing class and wait for animation
                        modalOverlay.setAttribute('closing', '');
                        setTimeout(() => {
                            this.closeModal(modalOverlay);
                        }, 240); // Match animation duration
                    } else {
                        // Desktop: Close immediately
                        this.closeModal(modalOverlay);
                    }
                },

                closeModal(modalOverlay) {
                    // Remove the closing attribute if it exists
                    modalOverlay?.removeAttribute('closing');
                    
                    // Get the scroll position from the body's top value
                    const scrollPos = Math.abs(parseInt(document.body.style.top || '0'));
                    
                    // Remove modal-open class and reset body styles
                    document.body.classList.remove('modal-open');
                    document.body.style.position = '';
                    document.body.style.width = '';
                    document.body.style.top = '';
                    
                    // Set the scroll position without using scrollTo
                    document.documentElement.style.scrollBehavior = 'auto';
                    document.documentElement.scrollTop = scrollPos;
                    document.body.scrollTop = scrollPos; // For Safari
                    document.documentElement.style.scrollBehavior = '';
                    
                    this.isOpen = false;
                    this.copyStatus = 'ready';
                    
                    // Reset all modal state including coupon data
                    this.currentStep = 1;
                    this.processingProgress = 0;
                    this.currentMessage = '';
                    this.showCheckmark = false;
                    this.codeRevealed = false;
                    this.isLoading = false;
                    this.isRevealed = false;
                    this.coupon = null;  // Add this line to reset coupon data
                },

                hideCode(code) {
                    if (!code) return '';
                    return code.substring(0, 3) + '***';
                },

                formatExpiry(validityDate) {
                    return validityDate || "No expiration";
                },

                formatDate(date) {
                    return new Date(date).toLocaleDateString();
                },
                formatTitle(title) {
                    if (!title) return '';
                    return utils.decodeHtmlEntities(title);
                },

                formatIncentive(incentive) {
                    if (!incentive) return '';
                    return utils.decodeHtmlEntities(incentive);
                },

                formatBrandName(brandName) {
                    if (!brandName) return '';
                    return utils.decodeHtmlEntities(brandName);
                },

                formatDescription(description) {
                    if (!description) return '';
                    return utils.decodeHtmlEntities(description);
                },

                formatCode(code) {
                    if (!code) return '';
                    try {
                        const visiblePart = code.slice(-4);
                        const hiddenPart = '•'.repeat(code.length - 4);
                        return hiddenPart + visiblePart;
                    } catch (error) {
                        console.error('Error formatting code:', error);
                        return '';
                    }
                },
                formatPartialCode(code) {
                    if (!code) return '';
                    const visiblePart = code.slice(0, -3);
                    const hiddenPart = '•'.repeat(3);
                    return visiblePart + hiddenPart;
                },   
                async showStep2() {
                    this.currentStep = 2;
                    this.processingProgress = 0;
                    this.currentMessage = '';
                    this.showCheckmark = false;
                    
                    const startTime = performance.now();
                    
                    const animate = (currentTime) => {
                        const elapsed = currentTime - startTime;
                        const progress = Math.min(elapsed / this.settings.totalDuration, 1);
                        
                        const eased = this.easeInOutCubic(progress);
                        this.processingProgress = eased * 100;
                        
                        // Update message based on progress
                        for (const step of this.settings.processSteps) {
                            if (this.processingProgress >= step.showAtPercent) {
                                this.currentMessage = step.message;
                            }
                        }

                        if (progress < 1) {
                            requestAnimationFrame(animate);
                        } else {
                            // Show checkmark animation
                            this.showCheckmark = true;
                            // Wait for animation and then move to step 3
                            setTimeout(() => this.showStep3(), 1500);
                        }
                    };

                    requestAnimationFrame(animate);
                },

                showStep3() {
                    this.currentStep = 3;
                },
        
                // Better easing function for smoother animation
                easeInOutCubic(x) {
                    return x < 0.5 ? 
                        4 * x * x * x : 
                        1 - Math.pow(-2 * x + 2, 3) / 2;
                },
                completeUnlock() {
                    this.codeRevealed = true;
                    this.isLoading = false;
                    this.isRevealed = true;
                },
                            handleUnlock(event, callback) {
                    const unlockMethod = this.settings?.locker?.unlock_method;
                    this.isLoading = true;  // Set loading state
                    
                    if (unlockMethod === 'timer') {
                        setTimeout(() => {
                            this.completeUnlock();
                        }, (this.settings?.locker?.unlock_delay || 5) * 1000);
                    } else if (unlockMethod === 'function') {
                        if (this.coupon?.url_type === 'redirect') {
                            window.open(this.coupon.coupon_locker_url, '_blank');
                        }
                        // Keep loading state until revealFullCode is called
                    }
                },

                // Separate method for revealing code
                revealCode() {
                    this.codeRevealed = true;
                },

                async copyCode() {
					try {
						if (!this.codeRevealed) return;

						if (navigator.clipboard && window.isSecureContext) {
							await navigator.clipboard.writeText(this.coupon.coupon_code);
							this.copyStatus = 'copied';
						} else {
							const textArea = document.createElement('textarea');
							textArea.value = this.coupon.coupon_code;
							
							textArea.style.position = 'fixed';
							textArea.style.left = '-999999px';
							textArea.style.top = '-999999px';
							document.body.appendChild(textArea);
							
							textArea.focus();
							textArea.select();
							document.execCommand('copy');
							textArea.remove();
							this.copyStatus = 'copied';
						}

						setTimeout(() => {
							this.copyStatus = 'ready';
						}, 2000);
					} catch (err) {
						console.error('Failed to copy code:', err);
					}
				}
            });
        });
        document.addEventListener('DOMContentLoaded', function() {
            const directCouponId = getCouponFromUrl();
            if (directCouponId) {
                const modalStore = Alpine.store('couponModal');
                if (modalStore) {
                    modalStore.open(parseInt(directCouponId));
                    
                    // Clean up URL but maintain other parameters if they exist
                    const newUrl = new URL(window.location.href);
                    newUrl.searchParams.delete('coupon');
                    window.history.replaceState({}, '', newUrl);
                }
            }
        });
    </script>
